{
  "name": "no-locals",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "supertest": "^7.2.2"
  },
  "scripts": {
    "start": "concurrently \"npm run start -w server\" \"npm run dev -w client\"",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "server": "npm run dev -w server",
    "client": "npm run dev -w client",
    "lint": "eslint client/src server",
    "test": "npm test -w client && npm test -w server",
    "test-server": "npm run dev -w server",
    "build": "npm install", 
    "server:prod": "npm start -w server",
    "client:build": "npm run build -w client"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "getpronto-sdk": "^1.3.1",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.22.2",
    "pg": "^8.20.0",
    "sharp": "^0.34.5"
  }
}
